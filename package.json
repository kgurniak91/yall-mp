{
  "name": "yall-mp",
  "description": "Yet Another Language Learning Media Player",
  "author": "Krzysztof Gurniak <kgurniak91@gmail.com> (https://kgurniak91.github.io)",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/kgurniak91/yall-mp"
  },
  "version": "0.9.8-beta",
  "main": "electron-main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:angular": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "test:electron": "tsc --project tsconfig.electron.json && vitest run",
    "test:native": "tsc --project tsconfig.electron.json && vitest run -c vitest.native.config.ts",
    "test:native:smoke": "tsc --project tsconfig.electron.json && electron test/native/electron-smoke/main.js",
    "test:all": "npm run test:angular && npm run test:electron",
    "test:e2e": "npm run electron:build && playwright test",
    "test:e2e:run": "playwright test",
    "e2e:fixtures": "node scripts/generate-test-media.js",
    "generate:licenses": "node scripts/generate-licenses.js",
    "electron:build": "npm run generate:licenses && ng build --configuration=electron && tsc --project tsconfig.electron.json",
    "electron:watch:build": "npm run generate:licenses && concurrently \"ng build --watch --configuration=electron\" \"tsc --watch --project tsconfig.electron.json\"",
    "electron:watch:run": "nodemon",
    "bench:kit": "node scripts/make-bench-kit.js",
    "soak": "node scripts/soak-video.js",
    "package:win": "npm run native:build && npm run electron:build && electron-builder --win",
    "package:mac": "npm run native:build && npm run electron:build && electron-builder --mac",
    "package:linux": "npm run native:build && npm run electron:build && electron-builder --linux",
    "build:github-pages": "node github-pages/build.js",
    "postinstall": "node scripts/download-dependencies.js && install-electron && npm run generate:licenses",
    "native:build": "node scripts/build-native.js",
    "native:build:debug": "node scripts/build-native.js --debug"
  },
  "build": {
    "appId": "com.yall-mp.app",
    "productName": "Y'ALL Media Player",
    "directories": {
      "output": "dist_electron"
    },
    "electronLanguages": [
      "en-US",
      "pl"
    ],
    "files": [
      "dist/yall-mp/browser/**/*",
      "electron-main.js",
      "libmpv-manager.js",
      "libmpv-bridge.js",
      "libmpv-host.js",
      "libmpv-frame-sender.js",
      "engine-restart.js",
      "bench-config.js",
      "native/yall-libmpv/build/Release/yall_libmpv.node",
      "native/yall-libmpv/build/Release/yall_fdpass.node",
      "playback-manager.js",
      "yomitan-manager.js",
      "shared/**/*.js",
      "src/app/model/**/*.js",
      "preload.js",
      "build/icon.png",
      "subtitles-lookup-host-preload.js",
      "subtitles-lookup-preload.js"
    ],
    "extraResources": [
      {
        "from": "public/THIRD-PARTY-NOTICES.txt",
        "to": "."
      }
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**",
      "**/*.node"
    ],
    "removePackageScripts": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "electron-resources/windows",
          "to": "electron-resources/windows",
          "filter": [
            "**/*.exe",
            "**/*.dll"
          ]
        },
        {
          "from": "electron-resources/extensions",
          "to": "electron-resources/extensions",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "mpv",
          "to": "mpv",
          "filter": [
            "**/*.lua"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp4",
            "mkv",
            "webm",
            "mov",
            "avi",
            "wmv",
            "flv",
            "mpg",
            "mpeg",
            "m4v",
            "mts",
            "m2ts",
            "ts",
            "vob",
            "3gp",
            "ogv",
            "divx",
            "mp3",
            "aac",
            "wma",
            "ogg",
            "flac",
            "wav",
            "aiff",
            "alac",
            "ape",
            "dsd",
            "pcm",
            "m4a",
            "m4b",
            "mka",
            "aa",
            "aax",
            "opus"
          ],
          "name": "Media File",
          "role": "Viewer"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "artifactName": "${productName} v${version}.${ext}",
      "electronLanguages": [
        "en",
        "pl"
      ],
      "extraResources": [
        {
          "from": "electron-resources/extensions",
          "to": "electron-resources/extensions",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "mpv",
          "to": "mpv",
          "filter": [
            "**/*.lua"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp4",
            "mkv",
            "webm",
            "mov",
            "avi",
            "wmv",
            "flv",
            "mpg",
            "mpeg",
            "m4v",
            "mts",
            "m2ts",
            "ts",
            "vob",
            "3gp",
            "ogv",
            "divx",
            "mp3",
            "aac",
            "wma",
            "ogg",
            "flac",
            "wav",
            "aiff",
            "alac",
            "ape",
            "dsd",
            "pcm",
            "m4a",
            "m4b",
            "mka",
            "aa",
            "aax",
            "opus"
          ],
          "name": "Media File",
          "role": "Viewer"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "artifactName": "${productName} v${version}.${ext}",
      "extraResources": [
        {
          "from": "electron-resources/extensions",
          "to": "electron-resources/extensions",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "mpv",
          "to": "mpv",
          "filter": [
            "**/*.lua"
          ]
        },
        {
          "from": "native/yall-libmpv/build/Release/yall-mpv-host",
          "to": "yall-mpv-host"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName} v${version}.exe"
    }
  },
  "private": true,
  "dependencies": {
    "@cospired/i18n-iso-languages": "^4.2.0",
    "ass-compiler": "^0.1.15",
    "fast-levenshtein": "^3.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "font-scanner": "^0.2.1",
    "fontkit": "^2.0.4",
    "franc-all": "^7.2.0",
    "media-captions": "^0.0.18",
    "ts-ebml": "^3.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/animations": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/common": "^19.2.15",
    "@angular/compiler": "^19.2.15",
    "@angular/compiler-cli": "^19.2.15",
    "@angular/core": "^19.2.15",
    "@angular/forms": "^19.2.15",
    "@angular/platform-browser": "^19.2.15",
    "@angular/platform-browser-dynamic": "^19.2.15",
    "@angular/router": "^19.2.15",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@fontsource-variable/noto-sans-arabic": "^5.2.10",
    "@fontsource-variable/noto-sans-bengali": "^5.2.10",
    "@fontsource-variable/noto-sans-hebrew": "^5.2.8",
    "@fontsource-variable/noto-sans-jp": "^5.2.9",
    "@fontsource-variable/noto-sans-kr": "^5.2.9",
    "@fontsource-variable/noto-sans-sc": "^5.2.9",
    "@fontsource-variable/noto-sans-tc": "^5.2.9",
    "@fontsource-variable/noto-sans-thai": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@ngneat/spectator": "^19.6.2",
    "@playwright/test": "^1.64.1",
    "@primeng/themes": "^19.1.3",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fontkit": "^2.0.8",
    "@types/jasmine": "~5.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "7zip-bin": "^5.2.0",
    "assjs": "^0.1.4",
    "cmake-js": "^7.4.0",
    "concurrently": "^9.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "fs-extra": "^11.3.2",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "lodash-es": "^4.17.21",
    "mustache": "^4.2.0",
    "ng-mocks": "^14.13.5",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "nodemon": "^3.1.10",
    "primeflex": "^4.0.0",
    "primeng": "^19.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "wavesurfer.js": "^7.9.5",
    "zone.js": "~0.15.0"
  }
}
